# SignalBridge AI — Local Orchestrator Environment
# Copy to .env and populate locally. Never commit .env with real secrets.

SIGNAL_BRIDGE_HOST=127.0.0.1
SIGNAL_BRIDGE_PORT=8787
SIGNAL_BRIDGE_DRY_RUN=true
SIGNAL_BRIDGE_CONFIG=./signalbridge.config.example.json

# Signal account registered or linked via signal-cli (E.164 format)
SIGNAL_ACCOUNT=+17575550199
SIGNAL_CLI_URL=http://127.0.0.1:8080/api/v1/rpc

# Comma-separated E.164 phone numbers and Signal group IDs allowed to invoke agents
SIGNAL_ALLOWLIST_PHONES=+17575550100,+17575550101
SIGNAL_ALLOWLIST_GROUPS=ops-local-alerts-group-01

# Enforce loopback-only backend endpoints (blocks remote egress and cloud metadata SSRF)
SIGNAL_LOCAL_ONLY=true

# Optional shared token required on POST /webhook/signal (X-SignalBridge-Token header)
SIGNAL_BRIDGE_INGEST_TOKEN=

# Optional backend credentials referenced by env var name in signalbridge.config.json
HERMES_API_KEY=
LOCAL_OPENAI_API_KEY=
SIGNALBRIDGE_WEBHOOK_SECRET=
