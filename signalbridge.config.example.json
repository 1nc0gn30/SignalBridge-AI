{
  "version": "1.0",
  "signalAccount": "+17575550199",
  "signalCliUrl": "http://127.0.0.1:8080/api/v1/rpc",
  "dryRun": true,
  "allowlist": {
    "phoneNumbers": [
      "+17575550100",
      "+17575550101"
    ],
    "groupIds": [
      "ops-local-alerts-group-01"
    ],
    "allowAllInDryRun": false
  },
  "rateLimit": {
    "maxRequests": 5,
    "windowMs": 60000
  },
  "security": {
    "localOnly": true,
    "allowPrivateLan": false,
    "maxMessageLength": 4000,
    "maxReplyChunkLength": 1800,
    "blockShellMetacharacters": true
  },
  "routes": [
    {
      "id": "ollama-default",
      "name": "Local Ollama (Llama 3.2)",
      "prefix": "/ollama",
      "adapter": "ollama",
      "endpoint": "http://127.0.0.1:11434",
      "model": "llama3.2",
      "systemPrompt": "You are a concise private assistant reached via Signal. Reply in plain text without unnecessary filler.",
      "timeoutMs": 30000,
      "maxTokens": 1024,
      "temperature": 0.3,
      "enabled": true,
      "isDefault": true
    },
    {
      "id": "hermes-agent",
      "name": "Hermes Local Agent",
      "prefix": "/hermes",
      "adapter": "hermes",
      "endpoint": "http://127.0.0.1:8642/v1/chat/completions",
      "model": "hermes-local",
      "apiKeyEnv": "HERMES_API_KEY",
      "systemPrompt": "Execute local operational queries safely and return structured status.",
      "timeoutMs": 45000,
      "maxTokens": 1536,
      "temperature": 0.2,
      "enabled": true
    },
    {
      "id": "openai-compat",
      "name": "OpenAI-Compatible (LM Studio / vLLM)",
      "prefix": "/code",
      "adapter": "openai-compatible",
      "endpoint": "http://127.0.0.1:1234",
      "model": "qwen2.5-coder-7b-instruct",
      "apiKeyEnv": "LOCAL_OPENAI_API_KEY",
      "systemPrompt": "Answer software engineering questions with concise, accurate code.",
      "timeoutMs": 30000,
      "maxTokens": 1536,
      "temperature": 0.2,
      "enabled": true
    },
    {
      "id": "local-webhook",
      "name": "Signed Local Webhook",
      "prefix": "/webhook",
      "adapter": "webhook",
      "endpoint": "http://127.0.0.1:9001/hooks/signal",
      "signingSecretEnv": "SIGNALBRIDGE_WEBHOOK_SECRET",
      "timeoutMs": 15000,
      "enabled": true
    }
  ]
}
