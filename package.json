{
  "name": "signalbridge-ai",
  "version": "1.0.0",
  "description": "Connect Signal (via signal-cli JSON-RPC) to local AI agents and backends with allowlists, rate limiting, SSRF guards, and dry-run simulation.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host=127.0.0.1 --port=4173",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bridge": "tsx bridge/cli.ts serve",
    "bridge:dry-run": "tsx bridge/cli.ts serve --dry-run",
    "bridge:sim": "tsx bridge/cli.ts simulate",
    "bridge:validate": "tsx bridge/cli.ts validate"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
